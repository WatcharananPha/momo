// ─────────────────────────────────────────────────────────────────────────────
// Momo Loyalty Platform — Prisma Schema
// Supabase PostgreSQL 15 compatible
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

generator client_py {
  provider = "prisma-client-py"
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Core Identity & Authentication
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid()) @db.Uuid
  lineUid           String?  @unique @map("line_uid")
  displayName       String   @map("display_name")
  profilePictureUrl String?  @map("profile_picture_url")
  isGuest           Boolean  @default(false) @map("is_guest")
  referralCode      String?  @unique @map("referral_code")
  referredBy        String?  @db.Uuid @map("referred_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  membership        Membership?
  pointBalance      UserPointBalance?
  pointTransactions PointTransaction[]
  creditWallet      CreditWallet?
  bookings          Booking[]
  reviews           Review[]
  notificationLogs  NotificationLog[]
  guestSessions     GuestSession[]
  maid              Maid?
  customerTags      CustomerTag[]
  slipUploads       SlipUpload[]

  @@map("users")
}

model GuestSession {
  id                String    @id @default(uuid()) @db.Uuid
  guestUuid         String    @unique @map("guest_uuid")
  token             String    @unique
  expiresAt         DateTime  @map("expires_at")
  convertedToUserId String?   @db.Uuid @map("converted_to_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  user              User?     @relation(fields: [convertedToUserId], references: [id])

  @@map("guest_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Loyalty & Gamification
// ─────────────────────────────────────────────────────────────────────────────

enum MembershipTier {
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model Membership {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @unique @db.Uuid @map("user_id")
  tier          MembershipTier @default(SILVER)
  nextTierPoints Int           @default(500) @map("next_tier_points")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id])

  @@map("memberships")
}

model UserPointBalance {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid @map("user_id")
  totalPoints     Int      @default(0) @map("total_points")
  availablePoints Int      @default(0) @map("available_points")
  lifetimePoints  Int      @default(0) @map("lifetime_points")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id])

  @@map("user_point_balances")
}

enum PointTransactionType {
  BOOKING_EARNED
  REVIEW_BONUS
  ONBOARDING
  REFERRAL
  CAMPAIGN_REWARD
  SPIN_WHEEL
  REDEEMED
}

model PointTransaction {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid @map("user_id")
  amount      Int
  type        PointTransactionType
  source      String?              // e.g., "BOOKING", "CAMPAIGN"
  referenceId String?              @map("reference_id") // ID of booking or campaign
  description String?
  createdAt   DateTime             @default(now()) @map("created_at")

  user        User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("point_transactions")
}

model PointRule {
  id          String  @id @default(uuid()) @db.Uuid
  ruleName    String  @unique @map("rule_name")
  pointAmount Int     @map("point_amount")
  isActive    Boolean @default(true) @map("is_active")

  @@map("point_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// Credit & Subscription Wallet
// ─────────────────────────────────────────────────────────────────────────────

model CreditWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid @map("user_id")
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])
  transactions CreditTransaction[]

  @@map("credit_wallets")
}

enum CreditTransactionType {
  TOP_UP
  BOOKING
  REFUND
  ADJUSTMENT
}

model CreditTransaction {
  id          String                @id @default(uuid()) @db.Uuid
  walletId    String                @db.Uuid @map("wallet_id")
  amount      Int
  type        CreditTransactionType
  referenceId String?               @map("reference_id")
  description String?
  createdAt   DateTime              @default(now()) @map("created_at")

  wallet      CreditWallet          @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@map("credit_transactions")
}

model CreditPackage {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  credits     Int
  price       Decimal  @db.Decimal(10, 2)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("credit_packages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Maid / Professional Management
// ─────────────────────────────────────────────────────────────────────────────

enum MaidTier {
  TRAINEE
  PRO
  ELITE
  MASTER
}

enum MaidStatus {
  PENDING
  ACTIVE
  ON_JOB
  INACTIVE
}

model Maid {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @unique @db.Uuid @map("user_id")
  fullName          String     @map("full_name")
  phoneNumber       String     @map("phone_number")
  profilePictureUrl String?    @map("profile_picture_url")
  tier              MaidTier   @default(TRAINEE)
  status            MaidStatus @default(PENDING)
  rating            Float      @default(5.0)
  jobCompleted      Int        @default(0) @map("job_completed")
  baseRate          Decimal    @db.Decimal(10, 2) @map("base_rate")
  testScore         Int?       @map("test_score")
  demographics      Json?      @default("{}")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  user              User       @relation(fields: [userId], references: [id])
  skills            MaidSkill[]
  bookings          Booking[]

  @@map("maids")
}

model MaidSkill {
  id     String @id @default(uuid()) @db.Uuid
  maidId String @db.Uuid @map("maid_id")
  skill  String // e.g., "GENERAL_CLEANING", "IRONING"
  level  Int    @default(1) // 1-5 scale

  maid   Maid   @relation(fields: [maidId], references: [id])

  @@index([maidId])
  @@map("maid_skills")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bookings & Operations
// ─────────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  AUTO_MATCHING
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingType {
  GENERAL_CLEANING
  DEEP_CLEANING
  LAUNDRY
  MOVING
  REPAIR
  COOKING
  IRONING
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid @map("user_id")
  maidId        String?       @db.Uuid @map("maid_id")
  type          BookingType
  status        BookingStatus @default(PENDING)
  scheduledAt   DateTime      @map("scheduled_at")
  locationName  String        @map("location_name")
  partySize     Int           @default(1) @map("party_size") // Duration/Rooms for Cleaning
  notes         String?
  totalAmount   Decimal?      @map("total_amount") @db.Decimal(10, 2)
  creditCost    Int?          @map("credit_cost")
  rerollCount   Int           @default(0) @map("reroll_count")
  pointsEarned  Int           @default(0) @map("points_earned")
  referenceCode String        @unique @map("reference_code")
  
  // Live Tracking Fields
  customerLat   Float?        @map("customer_lat")
  customerLng   Float?        @map("customer_lng")
  currentLat    Float?        @map("current_lat")
  currentLng    Float?        @map("current_lng")
  lastLocationAt DateTime?    @map("last_location_at")

  completedAt   DateTime?     @map("completed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id])
  maid          Maid?         @relation(fields: [maidId], references: [id])
  payment       Payment?
  review        Review?

  @@index([userId])
  @@index([maidId])
  @@map("bookings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment & Reviews
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CREDIT_CARD
  PROMPTPAY
  CREDIT_WALLET
  TRUE_MONEY
  SHOPEE_PAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  bookingId  String?       @unique @db.Uuid @map("booking_id")
  userId     String        @db.Uuid @map("user_id")
  amount     Decimal       @db.Decimal(10, 2)
  currency   String        @default("THB")
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  externalId String?       @map("external_transaction_id") // Omise/Gateway charge ID
  metadata   Json?         @default("{}")
  createdAt  DateTime      @default(now()) @map("created_at")

  booking    Booking?      @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @db.Uuid @map("booking_id")
  userId     String   @db.Uuid @map("user_id")
  maidId     String   @db.Uuid @map("maid_id")
  rating     Float
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  booking    Booking  @relation(fields: [bookingId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS & Campaigns
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  rewards     CampaignReward[]

  @@map("campaigns")
}

model CampaignReward {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid @map("campaign_id")
  rewardType String   // e.g., "COUPON", "POINTS"
  value      Int
  probability Float   @default(1.0) // For wheel spin probability

  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@map("campaign_rewards")
}

model CustomerTag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  tag       String
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("customer_tags")
}

enum SlipStatus {
  PENDING
  VERIFIED
  REJECTED
}

model SlipUpload {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid @map("user_id")
  imageUrl   String     @map("image_url")
  status     SlipStatus @default(PENDING)
  verifiedAt DateTime?  @map("verified_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id])

  @@map("slip_uploads")
}

model NotificationLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  type      String   // "LINE", "SMS", "IN_APP"
  title     String
  message   String
  status    String   // "SENT", "FAILED"
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("notification_logs")
}

model TierRule {
  id        String @id @default(uuid()) @db.Uuid
  tierName  String @unique @map("tier_name")
  minPoints Int    @map("min_points")
  maxPoints Int?   @map("max_points")
  benefits  Json   @default("{}")

  @@map("tier_rules")
  }